<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Main app theme -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <!--
          L'app ha un solo tema (sempre scuro): questo flag a livello di
          Activity e' il segnale che alcuni WebView OEM (Xiaomi/Oppo/Vivo)
          controllano per le proprie funzioni di "colore intelligente"/
          "modalita' lettura", indipendentemente dalle API WebView standard
          gia' disattivate in MainActivity.java. Richiede API 29+, ignorato
          senza errori sulle versioni precedenti.
        -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Splash screen theme -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">

        <!-- Background -->
        <item name="windowSplashScreenBackground">#002b4f</item>

        <!-- App icon -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>

        <!-- Optional icon background -->
        <item name="windowSplashScreenIconBackgroundColor">#002b4f</item>

        <!-- Theme after splash -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>

    </style>

</resources>